# NuRoute self-hosted settings. install.sh copies this to .env and fills in the secrets; you
# only need to set NUROUTE_DOMAIN (install.sh asks for it). Keep .env private and backed up:
# the encryption keys below protect the provider keys stored in your database.

# The address your team will open, without https:// (for example nuroute.acme.com). Point its
# DNS at this server; HTTPS certificates are obtained automatically.
NUROUTE_DOMAIN=

# The NuRoute release to run. upgrade.sh changes this for you.
NUROUTE_VERSION=1.0.1

# Behind your own HTTPS proxy or load balancer? Set CADDY_SITE=:80 and point the proxy at port 80.
# CADDY_SITE=:80

# Generated by install.sh. Never change the two encryption keys after the first start: data
# encrypted with them could no longer be read.
POSTGRES_PASSWORD=GENERATED_BY_INSTALL
JWT_SECRET=GENERATED_BY_INSTALL
AUTH_ENCRYPTION_KEY=GENERATED_BY_INSTALL
PROVIDER_ENCRYPTION_KEY=GENERATED_BY_INSTALL

# Where images come from. Change only if NuRoute asks you to (for example a private mirror).
NUROUTE_REGISTRY=ghcr.io/nuroute-ai
